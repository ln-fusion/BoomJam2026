{
  "servers": {
    "unityMCP": {
      "command": "${userHome}/.local/bin/uvx.exe",
      "args": [
        "--offline",
        "--prerelease",
        "explicit",
        "--from",
        "mcpforunityserver>=0.0.0a0",
        "mcp-for-unity",
        "--transport",
        "stdio"
      ],
      "type": "stdio"
    }
  }
}
